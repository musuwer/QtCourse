QPushButton#startServerButton{ background:#c8e6c9; }
QPushButton#startServerButton:hover{ background:#b9dfba; }

QPushButton#stopServerButton{ background:#ffd6d6; }
QPushButton#stopServerButton:hover{ background:#ffbdbd; }
