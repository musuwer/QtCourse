QGroupBox{
  font-weight:600;
  border:1px solid #f1e6d8;
  border-radius:12px;
  margin-top:12px;
  background:rgba(255,255,255,0.85);
}
QGroupBox::title{
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left:12px;
  padding:0 6px;
  color:#6b4f3a;
}

QLabel{ color:#5e4632; }

QLineEdit, QSpinBox, QPlainTextEdit, QTextBrowser, QListWidget{
  border:1px solid #f1e6d8;
  border-radius:10px;
  background:#ffffff;
  padding:6px;
}

QListWidget::item{ padding:7px 10px; border-radius:8px; }
QListWidget::item:hover{ background:#fff1dd; }
QListWidget::item:selected{ background:#FFE6A7; }

QPushButton{
  border:none;
  border-radius:10px;
  padding:8px 12px;
  background:#f2e8e0;
  color:#5e4632;
  font-weight:600;
}
QPushButton:hover{ background:#eadcd2; }
QPushButton:pressed{ background:#e2d0c4; }
QPushButton:disabled{ background:#f6f0ea; color:#b8a79a; }

QPushButton#sendButton{ background:#ffcb8a; }
QPushButton#sendButton:hover{ background:#ffb86b; }

QPushButton#connectButton{ background:#cce8ff; }
