  <property name="styleSheet">
   <string notr="true">#titleLabel {
background: #3498db;
color: #ecf0f1;
border: 1px solid #2980b9;
padding: 5px;
font:36px 'Helvetica',sans-serif;
}

#loginVerticalLayout {
background: qlineargradient(x1:0, y1:0, x3:0, y2:1, stop:0 #ecf0f1, stop:1 #3498db);
border: 1px solid #bdc3c7;
padding: 10px;
border-radius: 15px;
}

#nameEdit, #IPEdit {
background: #ecf0f1;
border: 1px solid #bdc3c7;
padding: 5px;
}
#btnLogin, #btnExit, #btnSent, #btnLogout {
background: #3498db;
color: #ecf0f1;
border: 1px solid #2980b9;
padding: 5px 10px;
border-radius: 5px;
}
#textEdit {
background: #ecf0f1;
border: 1px solid #bdc3c7;
padding: 5px;
}
#listWidget {
background: #ecf0f1;
border: 1px solid #bdc3c7;
padding: 5px;
max-width: 120px;
}

#messageEdit {
background: #ecf0f1;
border: 1px solid #bdc3c7;
padding: 5px;
}
/* 聊天页背景 */
#chatPage {
    background-color: #ffffff;
}

/* 聊天记录显示框 */
#roomTextEdit {
    background-color: #f5f5f5; /* 浅灰背景 */
    border: none;
    border-right: 1px solid #e0e0e0; /* 分割线 */
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 14px;
    padding: 10px;
}

/* 用户列表 */
#UserListWidget {
    background-color: #ffffff;
    border: none;
    outline: none;
    font-size: 13px;
    color: #333;
}
#UserListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f0f0f0;
}
#UserListWidget::item:selected {
    background-color: #e6f7ff;
    color: #1890ff;
}
#UserListWidget::item:hover {
    background-color: #f9f9f9;
}

/* 底部输入区域 */
#messageEdit {
    border: 1px solid #dcdfe6;
    border-radius: 20px; /* 圆角输入框 */
    padding: 8px 15px;
    background-color: #ffffff;
    font-size: 14px;
    margin-right: 10px;
}
#messageEdit:focus {
    border: 1px solid #3498db;
}

/* 发送按钮 */
#btnSent {
    background-color: #3498db;
    border-radius: 18px; /* 圆形或椭圆按钮 */
    color: white;
    padding: 6px 20px;
    font-weight: bold;
}

#name_label, #ip_label {
background: #ecf5f1;
}</string>
